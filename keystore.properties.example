# Copy this file to keystore.properties (repo root) and fill in real values to
# build a signed release. keystore.properties is gitignored — the keystore and
# its passwords must never be committed.
#
# Create an upload keystore once with:
#   keytool -genkeypair -v -keystore prompter-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias prompter
#
# Keep the .jks file and these passwords backed up somewhere safe: losing the
# upload key means you can no longer publish updates under the same listing
# (recoverable via Play App Signing key reset, but only with Google's help).

# Path to the keystore, relative to the repo root.
storeFile=prompter-upload.jks
storePassword=CHANGE_ME
keyAlias=prompter
keyPassword=CHANGE_ME
