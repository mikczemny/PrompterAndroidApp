<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ equivalent of backup_rules.xml, covering both cloud backup and
  device-to-device transfer. Language models are re-downloadable, so they are
  excluded from each.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models" />
    </device-transfer>
</data-extraction-rules>
