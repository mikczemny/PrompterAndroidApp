<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 equivalent of data_extraction_rules.xml. Language models are
  excluded from backup: they run to ~50 MB each and several hundred MB
  together, they are re-downloadable from a public URL, and shipping them to
  cloud backup would burn the user's quota to restore something the app can
  fetch again on demand. Scripts are excluded because they're the user's own
  unpublished writing, not because of size.
-->
<full-backup-content>
    <exclude domain="file" path="models" />
    <exclude domain="file" path="scripts" />
    <exclude domain="sharedpref" path="recordings.xml" />
    <exclude domain="external" path="recordings" />
</full-backup-content>
