<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground for the adaptive icon: a green "speech line" bar over script
     lines, evoking a voice-tracked teleprompter. Drawn inside the inner 72dp
     safe zone of the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- script lines (dimmed) -->
    <path
        android:fillColor="#5A5A5E"
        android:pathData="M30,40 h48 a2,2 0 0 1 0,4 h-48 a2,2 0 0 1 0,-4 z" />
    <path
        android:fillColor="#E7E7EA"
        android:pathData="M30,52 h48 a2,2 0 0 1 0,4 h-48 a2,2 0 0 1 0,-4 z" />
    <path
        android:fillColor="#5A5A5E"
        android:pathData="M30,64 h36 a2,2 0 0 1 0,4 h-36 a2,2 0 0 1 0,-4 z" />

    <!-- the "read here" guide line, highlighted -->
    <path
        android:fillColor="#7EE787"
        android:pathData="M26,50 h56 a2,2 0 0 1 0,8 h-56 a2,2 0 0 1 0,-8 z"
        android:fillAlpha="0.35" />

    <!-- mic dot -->
    <path
        android:fillColor="#7EE787"
        android:pathData="M54,74 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
